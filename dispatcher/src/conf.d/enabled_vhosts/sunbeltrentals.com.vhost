#
# This is the default publish virtualhost definition for Apache.
#
# DO NOT EDIT this file, your changes will have no impact on your deployment.
#
# Instead create a copy in the folder conf.d/available_vhosts and edit the copy.
# Finally, change to the directory conf.d/enabled_vhosts, remove the symbolic
# link for default.vhost and create a symbolic link to your copy.
#

# Include customer defined variables
Include conf.d/variables/custom.vars

<VirtualHost *:80>
	ServerName	"dev-www.sunbeltrentals.com"
	# Use a document root that matches the one in conf.dispatcher.d/default.farm
	DocumentRoot "${DOCROOT}"
	# Increase max header size to support all Domain cookies across AEM and Command Center
	LimitRequestFieldSize 16380
	# URI dereferencing algorithm is applied at Sling's level, do not decode parameters here
	AllowEncodedSlashes NoDecode
	# Add header breadcrumbs for help in troubleshooting
	<IfModule mod_headers.c>
		Header add X-Vhost "dev-www.sunbeltrentals.com"
		Header set Content-Disposition "inline" env=VIEW_PDF_HEADER
		Header set Permissions-Policy "browsing-topics=()"
	</IfModule>
	<Directory />
		<IfModule disp_apache2.c>
			# Some items cache with the wrong mime type
			# Use this option to use the name to auto-detect mime types when cached improperly
			ModMimeUsePathInfo On
			# Use this option to avoid cache poisioning
			# Sling will return /content/image.jpg as well as /content/image.jpg/ but apache can't search /content/image.jpg/ as a file
			# Apache will treat that like a directory.  This assures the last slash is never stored in cache
			DirectorySlash Off
			# Enable the dispatcher file handler for apache to fetch files from AEM
			SetHandler dispatcher-handler
		</IfModule>
		Options FollowSymLinks Includes
		AllowOverride None
		# Insert filter
		SetOutputFilter INCLUDES
		# Don't compress images
		ModMimeUsePathInfo On
		AddOutputFilter INCLUDES .html
		SetEnvIfNoCase Request_URI \.(?:gif|jpe?g|png)$ no-gzip dont-vary
		# Prevent clickjacking
		Header always append X-Frame-Options SAMEORIGIN
	</Directory>
	<Directory "${DOCROOT}">
		Options Indexes FollowSymLinks Includes
		AllowOverride None
		Require all granted
	</Directory>
	<IfModule disp_apache2.c>
		# Enabled to allow rewrites to take affect and not be ignored by the dispatcher module
		DispatcherUseProcessedURL	1
		# Default setting to allow all errors to come from the aem instance
		DispatcherPassError		1
	</IfModule>
	<IfModule mod_rewrite.c>
		RewriteEngine	on
		Include conf.d/rewrites/rewrite.rules

		# Rewrite index page internally, pass through (PT)
		#RewriteRule "^(/?)$" "en_US.html" [PT]

	</IfModule>
	<LocationMatch "\.(html)$">
        Header unset Cache-Control
        Header set Surrogate-Control "max-age=0"
        Header always set Cache-Control "max-age=120,s-maxage=600,stale-while-revalidate=43200,stale-if-error=43200"
    </LocationMatch>
    # for home page 12 hours stale-after
	<LocationMatch "^/content/.*/en_US\.html$">
        Header unset Cache-Control
        Header always set Cache-Tag: homepage
        Header always set Cache-Control "max-age=120,s-maxage=600,stale-while-revalidate=3600,stale-if-error=3600" "expr=%{REQUEST_STATUS} < 400"
        Header set Age 0
    </LocationMatch>
    # for static pages 24 hours stale-after
    <LocationMatch "^/content/.*/(about|industries).*\.html$">
        Header unset Cache-Control
        Header always set Cache-Tag: staticpages
        Header always set Cache-Control "max-age=120,s-maxage=600,stale-while-revalidate=3600,stale-if-error=3600" "expr=%{REQUEST_STATUS} < 400"
        Header set Age 0
    </LocationMatch>
    <LocationMatch "^/content/.*/(location-details-page|equipment-rental).*\.html/.*$">
        Header unset Cache-Control
        Header always set Cache-Tag: catalogpages
        Header always set Cache-Control "max-age=120,s-maxage=600,stale-while-revalidate=3600,stale-if-error=3600" "expr=%{REQUEST_STATUS} < 400"
        Header set Age 0
    </LocationMatch>
    <LocationMatch "^/content/experience-fragments/.*\.sharedcontent.html*">
        Header unset Cache-Control
        Header always set Cache-Tag: experiencefragment
        Header always set Cache-Control "max-age=120,s-maxage=600,stale-while-revalidate=3600,stale-if-error=3600" "expr=%{REQUEST_STATUS} < 400"
        Header set Age 0
    </LocationMatch>
    #Setting max-age same as SDI TTL for Header
    <LocationMatch "^/content/experience-fragments/sunbeltrentals/.*/.*/header/master/_jcr_content.content.sharedcontent.html*">
        Header unset Cache-Control
        Header always set Cache-Tag: experiencefragment
        Header always set Cache-Control "max-age=21600,s-maxage=21600,stale-while-revalidate=21600,stale-if-error=21600" "expr=%{REQUEST_STATUS} < 400"
        Header set Age 0
    </LocationMatch>
	# Disable Fastly CDN, CDN Caching Policy managed at Akamai CDN
    <LocationMatch "\.(svg|ico|png|jpg|gif|jpeg|woff2|ttf|woff|eot)$">
        Header set Surrogate-Control "max-age=0"
    </LocationMatch>
    <LocationMatch "\.(css|js)$">
        Header set Surrogate-Control "max-age=0"
    </LocationMatch>

    # Theme Sources via Clientlib: cache mutable resources for 24h on CDN and background refresh to avoid MISS
    <LocationMatch "^/etc\.clientlibs/.*\.(?i:json|png|gif|jpe?g|svg)$">
    Header set Cache-Control "max-age=86400,s-maxage=86400,stale-while-revalidate=43200,stale-if-error=43200,public"
    </LocationMatch>
    # Theme Sources via Clientlib: long-term caching (30 days) for immutable URLs, background refresh to avoid MISS
    <LocationMatch "^/etc\.clientlibs/.*\.(?i:js|css|ttf|woff2)$">
    Header set Cache-Control "max-age=2592000,stale-while-revalidate=43200,stale-if-error=43200,public,immutable"
    </LocationMatch>
    # Images/Video from DAM: cache mutable resources for 24h on CDN and background refresh to avoid MISS
    <LocationMatch "^/content/dam/.*\.(?i:jpe?g|gif|ico|mov|png|svg|pdf)$">
    Header set Cache-Control "max-age=14400,s-maxage=86400,stale-while-revalidate=43200,stale-if-error=43200"
    </LocationMatch>
    <LocationMatch "^/content/dam/sunbeltrentals/en/media/icons/.*\.(?i:jpe?g|gif|ico|mov|png|svg)$">
        Header set Cache-Control "max-age=86400,s-maxage=86400,stale-while-revalidate=43200,stale-if-error=43200"
    </LocationMatch>
    <LocationMatch "^/content/(.*)/en_US/.*\.html$">
        Header set Surrogate-Control "max-age=0"
        ErrorDocument 404 /error/404/
        ErrorDocument 500 /error/500/
    </LocationMatch>

    <LocationMatch "^/content/sunbeltrentals/.*ccaconfiguration.model\.json$">
        Header set Cache-Control "max-age=120,s-maxage=600,stale-while-revalidate=3600,stale-if-error=3600"
    </LocationMatch>

    <LocationMatch "^/content/experience-fragments/sunbeltrentals/.*genericconfigs.model\.json$">
        Header set Cache-Control "max-age=120,s-maxage=600,stale-while-revalidate=3600,stale-if-error=3600"
    </LocationMatch>

    <LocationMatch "^/content/(.*)/en-ca/.*\.html$">
        Header set Surrogate-Control "max-age=0"
        ErrorDocument 404 /en-ca/error/404/
        ErrorDocument 500 /en-ca/error/500/
    </LocationMatch>
    <LocationMatch "^/static/(.*)">
        ProxyPass   https://static-p46613-e216572.adobeaemcloud.com/$1
        ProxyPassReverse https://static-p46613-e216572.adobeaemcloud.com/$1
        Order allow,deny
        Allow from all
    </LocationMatch>
</VirtualHost>

