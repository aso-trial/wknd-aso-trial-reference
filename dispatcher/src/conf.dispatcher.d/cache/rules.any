#
# This file contains the cache rules, and can be customized.
#
# By default, it includes the default rules.
#

$include "./default_rules.any"

# Disable caching for /content/page/abhi.html
/0100 {
    /glob "/content/page/abhi.html"
    /type "deny"
}

# Bug 4: unclosed brace in cache rule
/0200 {
    /glob "/content/dam/*"
    /type "allow"

/0300 {
    /glob "/etc.clientlibs/*"
    /type "allow"
}
