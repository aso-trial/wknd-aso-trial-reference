#
# This file contains the filter ACL, and can be customized.
#
# By default, it includes the default filter ACL.
#

$include "./default_filters.any"

/0100 { /type "allow" /method "GET" /url "/services/export/xf-dependencies" }

/0113 { /type "allow" /method "POST" /url "/services/punchout" }

# Allow robots.txt selector
/0114 { /type "allow" /method "GET" /path "/content/*" /selectors 'robots' /extension "txt" }

/0115 { /type "allow" /method "POST" /url "/content/cq:graphql/sunbeltrentals/endpoint.json" /extension "json" }

/0116 { /type "allow" /url "/graphql/execute.json/*"}

/0117 { /type "allow" /method '(GET|POST)' /url "/services/logout" }

/0118 { /type "allow" /extension "json" /selectors "model" /path "/content/experience-fragments/sunbeltrentals/*/genericconfigs" }

/0119 { /type "allow" /extension "json" /selectors "model" /path "/content/sunbeltrentals/*/ccaconfiguration" }

/0120 { /type "allow" /method "POST" /url "/content/cq:graphql/tracker/endpoint.json" /extension "json" }

/0121 { /type "allow" /method "GET" /extension "json" /selectors "model" /path "/content/sunbeltrentals/*/myaccount/*" }